# Agent-coordination Supabase project. Never commit the service-role secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated local Kilo server. Bind it to 127.0.0.1 only.
KILO_SERVER_URL=http://127.0.0.1:4096
KILO_SERVER_USERNAME=kilo
KILO_SERVER_PASSWORD=

# Kilo Gateway's fixed free model. No automatic paid fallback.
KILO_MODEL=nvidia/nemotron-3.5-super-vl:free
# Logical workspace names map to absolute paths, never supplied by commands.
KILO_WORKSPACES_JSON='{"demo":"/opt/kilo-workspaces/demo"}'
BRIDGE_APP_DIR=/opt/kilo-bridge

BRIDGE_ID=
BRIDGE_POLL_INTERVAL_MS=10000
BRIDGE_REQUEST_TIMEOUT_MS=30000
BRIDGE_CLAIM_LEASE_SECONDS=60
LOG_LEVEL=info
