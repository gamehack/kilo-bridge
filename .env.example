# Agent-coordination Supabase project. Never commit the service-role secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated local Kilo server. Bind it to 127.0.0.1 only.
KILO_SERVER_URL=http://127.0.0.1:4096
KILO_SERVER_USERNAME=kilo
KILO_SERVER_PASSWORD=

# Kilo Gateway's fixed free model. No automatic paid fallback.
KILO_MODEL=nvidia/nemotron-3.5-super-vl:free
# Worker host ID must match the target_host of commands and host_id of sessions.
# Existing Silicon Valley commands are assigned to silicon-valley-01.
BRIDGE_HOST_ID=silicon-valley-01

# For Mac worker ONLY: set BRIDGE_HOST_ID=macbook-01, remove
# SUPABASE_SERVICE_ROLE_KEY completely, and use the restricted HTTPS broker.
# KILO_BROKER_URL=https://YOUR_PROJECT.supabase.co/functions/v1/kilo-host-broker
# KILO_BROKER_TOKEN=GENERATE_32_RANDOM_BYTES_AND_KEEP_PRIVATE

# Default when create_session does not provide an absolute directory.
# On Mac use /Users/gamehack/kilo-workspaces (after creating it).
# No workspace allowlist: the OS user's permissions are the boundary.
KILO_DEFAULT_DIRECTORY=/home/ubuntu

BRIDGE_ID=
BRIDGE_POLL_INTERVAL_MS=10000
BRIDGE_REQUEST_TIMEOUT_MS=30000
BRIDGE_CLAIM_LEASE_SECONDS=60
LOG_LEVEL=info

# Opt in to automatically resolve live approvals for the current host/turn.
BRIDGE_AUTO_APPROVE=false
